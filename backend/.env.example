# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# --- Retrieval (hybrid search) ---

# Max hits from each of semantic and full-text search before RRF fusion.
RETRIEVAL_CANDIDATE_K=50
# Final number of fused passages returned.
RETRIEVAL_TOP_K=10
# RRF smoothing constant k in 1 / (k + rank).
RETRIEVAL_RRF_K=60
# Neighboring chunks (same document, by chunk_index) attached to each hit.
RETRIEVAL_NEIGHBOR_RADIUS=1
# Postgres text-search config; must match to_tsvector used at ingest.
RETRIEVAL_FTS_CONFIG=english


# --- Langfuse ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# --- Email agent (Yahoo ingest). Optional at API startup. ---
# Put the real app password in backend/.env only. Do not commit it.
# Yahoo Account Security → Generate app password. The normal Yahoo password will not work.

YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=
# Supabase user id (users.id) that owns this mailbox. Ingest refuses to run when this is empty.
EMAIL_AGENT_OWNER_USER_ID=
# Supabase user id (users.id) of the only user who may open the Finance agent. Finance is off for everyone when empty.
FINANCE_OWNER_USER_ID=
# Sender → newsletter source. A full address is matched exactly; a bare domain matches any sender at that domain.
AI_NEWSLETTER_DOMAINS=tldrnewsletter.com=tldr,news@alphasignal.ai=alpha_signal
# Jev labels mail. Chat stays on OPENAI_CHAT_MODEL.
# Create a key at https://typesafe.ai. Pin a version such as jev-1.13.0 once the
# labels are tuned; jev-latest moves when TypeSafe ship a release.
TYPESAFE_API_KEY=
TYPESAFE_LABEL_MODEL=jev-latest
# PDFs at or under this size are stored. Larger ones keep a row with no bytes.
ATTACHMENT_MAX_BYTES=10485760
# Edition date of an AI newsletter is sent_at in this timezone.
EMAIL_TIMEZONE=Europe/Berlin
# Cross-source items inside this many hours of an edition can form one story.
NEWS_MATCH_WINDOW_HOURS=48

# --- Finance: Enable Banking (bank account access). Optional at API startup. ---
# Control panel at enablebanking.com → Applications. Connecting a bank fails with a clear error until all three are set.
# Application id (UUID) from the control panel; the downloaded key file is often named after it.
ENABLE_BANKING_APP_ID=
# Contents of the private key .pem created when the application was registered. Keep it in backend/.env and Railway only.
# Either the whole file in double quotes over several lines, or one line with each line break written as \n.
ENABLE_BANKING_PRIVATE_KEY=
# Where the bank sends the browser back. Must also be listed in the application's redirect URLs in the control panel.
# Enable Banking accepts only https, localhost included: run the dev server on https (frontend/README.md).
ENABLE_BANKING_REDIRECT_URL=https://localhost:5173/finance/accounts/callback
