# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# --- Retrieval (hybrid search) ---

# Max hits from each of semantic and full-text search before RRF fusion.
RETRIEVAL_CANDIDATE_K=50
# Final number of fused passages returned.
RETRIEVAL_TOP_K=10
# RRF smoothing constant k in 1 / (k + rank).
RETRIEVAL_RRF_K=60
# Neighboring chunks (same document, by chunk_index) attached to each hit.
RETRIEVAL_NEIGHBOR_RADIUS=1
# Postgres text-search config; must match to_tsvector used at ingest.
RETRIEVAL_FTS_CONFIG=english
